{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CompilerPro",
  "version": "0.1.0",
  "identifier": "com.taufanzamzami.compilerpro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CompilerPro",
        "width": 1320,
        "height": 840,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["tex", "ltx"], "name": "LaTeX document", "role": "Editor" },
      { "ext": ["md", "markdown"], "name": "Markdown document", "role": "Editor" },
      { "ext": ["mmd", "mermaid"], "name": "Mermaid diagram", "role": "Editor", "mimeType": "text/vnd.mermaid" }
    ]
  }
}
